# ─────────────────────────────────────────────────────────────
# Kishwour — environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit real values. On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Database: Neon PostgreSQL ───────────────────────────────
# Neon Console → your project → Connect → choose the branch, database and role.
# Use the "Pooled connection" string for DATABASE_URL (host contains "-pooler")
# and the direct string (pooling turned off) for DIRECT_URL.
# Use ?sslmode=verify-full: node-postgres warns that it will stop treating "require" as
# full certificate verification, and verify-full is the setting Neon recommends anyway.
#
# Format (placeholders only):
#   postgresql://ROLE:PASSWORD@ep-NAME-ID-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
#   postgresql://ROLE:PASSWORD@ep-NAME-ID.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
#
# Pooled connection, used by the app at runtime (required)
DATABASE_URL=
# Direct connection, used by Prisma CLI for migrations (required for Neon)
DIRECT_URL=
# Optional: separate empty branch/database for `prisma migrate dev` shadow database
# SHADOW_DATABASE_URL=
# Runtime driver: "pg" (default, TCP — use everywhere that allows it, incl. Vercel) or
# "neon-http" (HTTPS only — for sandboxes without raw TCP; no transactions).
# The `*:cloud` npm scripts set this for you.
# DATABASE_DRIVER=pg

# Auth.js (required once admin login is built)
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Canonical app URL, e.g. http://localhost:3000 (optional on Vercel)
AUTH_URL=
# First administrator (used once by `npm run admin:create`; remove the password afterwards)
# ADMIN_NAME=
# ADMIN_INITIAL_PASSWORD=

# Cloudinary (required for product/category image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (required for inquiry notification emails)
RESEND_API_KEY=
# Inbox that receives new inquiry notifications (also the first admin login, see docs)
ADMIN_EMAIL=
# Sender address for quotation emails, on a domain verified in Resend
# EMAIL_FROM="Kishwour <quotes@example.com>"

# Public site URL, used for metadata, sitemap and absolute links (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
